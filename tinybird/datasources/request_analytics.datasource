DESCRIPTION Request analytics from AI Gateway LLM calls

SCHEMA >
    `id` String `json:$.id` DEFAULT generateUUIDv4(),
    `response_id` String `json:$.response_id` DEFAULT '',
    `timestamp` DateTime `json:$.timestamp` DEFAULT now(),
    `gateway_id` String `json:$.gateway_id` DEFAULT '',
    `model` String `json:$.model` DEFAULT '',
    `provider` String `json:$.provider` DEFAULT '',
    `tokens_prompt` Int32 `json:$.tokens_prompt` DEFAULT 0,
    `tokens_completion` Int32 `json:$.tokens_completion` DEFAULT 0,
    `tokens_total` Int32 `json:$.tokens_total` DEFAULT 0,
    `request_type` String `json:$.request_type` DEFAULT '',
    `status` Bool `json:$.status` DEFAULT false,
    `cost` Float64 `json:$.cost` DEFAULT 0,
    `latency` Float64 `json:$.latency` DEFAULT 0,
    `queue_time` Float64 `json:$.queue_time` DEFAULT 0,
    `prompt_time` Float64 `json:$.prompt_time` DEFAULT 0,
    `completion_time` Float64 `json:$.completion_time` DEFAULT 0,
    `error_message` String `json:$.error_message` DEFAULT '',
    `prompt_text` String `json:$.prompt_text` DEFAULT '',
    `response_text` String `json:$.response_text` DEFAULT '',
    `http_status_code` Int32 `json:$.http_status_code` DEFAULT 0,
    `endpoint` String `json:$.endpoint` DEFAULT ''

ENGINE "MergeTree"
ENGINE_SORTING_KEY "timestamp"
