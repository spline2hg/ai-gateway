# App
ENVIRONMENT=development

# Database
# Dev uses SQLite automatically. In production set ENVIRONMENT=production
# and point DATABASE_URL at PostgreSQL. Start it with: docker compose up -d
# (compose reads these vars from your .env)
POSTGRES_USER=aigateway
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_gateway
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aigateway:change-me@localhost:5432/ai_gateway

# CORS
CORS_ORIGINS=http://localhost:3000

# Free Model Provider
FREE_MODEL_BASE_URL=https://your-provider.com/v1
FREE_MODEL_API_KEY=your_api_key_here
FREE_MODEL_NAME=your_model_name_here
