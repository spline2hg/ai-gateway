# App
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://user:password@localhost/ai_gateway

# CORS
CORS_ORIGINS=http://localhost:3000

# Free Model Provider
FREE_MODEL_BASE_URL=https://your-provider.com/v1
FREE_MODEL_API_KEY=your_api_key_here
FREE_MODEL_NAME=your_model_name_here

# Analytics
ANALYTICS_BACKEND=clickhouse
CLICKHOUSE_URL=clickhouse+http://workspace:token@clickhouse.us-east.aws.tinybird.co:443/default?protocol=https
TINYBIRD_TOKEN=your_tinybird_token_here
TINYBIRD_API_URL=https://api.us-east.aws.tinybird.co
